# Run python -m orderfix.setup_local to create .env without printing secrets.
AGENT_SEED=
AGENT_PORT=8001
# One-time Agentverse mailbox registration only; keep private and never paste in chat.
AGENTVERSE_API_KEY=
ORDERFIX_DB=data/orderfix.sqlite3
STORE_MODE=demo
ENABLE_CARDS=true
# Optional; no API call is made without a key. Never paste a key in chat.
ASI1_API_KEY=
ASI1_MODEL=asi1
# Only needed for a merchant-authorized development store.
SHOPIFY_TEST_STORE=false
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Static token alternative, if supplied by your authorized app setup.
SHOPIFY_ACCESS_TOKEN=

# Optional QuickFix post-purchase cancellation/refund extension.
# Keep false for the original workflow; opt in with QUICKFIX_ENABLED=true.
QUICKFIX_ENABLED=false
# Use `python -m orderfix.commerce.connected` for the real merchant path.
# It forces these real-only settings and uses a separate data/quickfix-connected database.
# Missing connections return a waiting message; no sample orders are substituted.
QUICKFIX_REQUIRE_REAL=false
QUICKFIX_DB=data/quickfix.sqlite3
# Choices: simulated, razorpay_test, unconfigured, razorpay_live.
# For direct merchant setup choose unconfigured while payment access is pending.
QUICKFIX_GATEWAY=simulated
# Replace this with the merchant's explicit opaque account reference for real mode.
QUICKFIX_MERCHANT_REF=demo-pharmacy
# Exact signed peer addresses; leave blank until the peers are configured.
# A README-published address alone does not establish contract compatibility.
MEDGUARDIAN_AGENT_ADDRESS=
MAIL_AGENT_ADDRESS=
QUICKFIX_PHARMACY_MODE=simulated
QUICKFIX_MAIL_MODE=captured
# Only enable for explicitly synthetic isolated demo customers.
QUICKFIX_AUTO_DEMO=false
# Default false. Enable only after the merchant grants refund access and the
# connected pharmacy/payment binding has been verified. User approval is still required.
QUICKFIX_ENABLE_LIVE_REFUNDS=false
# Optional Razorpay credentials must match the chosen mode (rzp_test_ / rzp_live_).
# Never paste secrets in chat or Git. No credentials are needed for waiting mode.
# No captured gateway payment is included with the simulated fixtures.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
